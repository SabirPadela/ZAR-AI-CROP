rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        (!('region' in data) || (data.region is string && data.region.size() <= 100)) &&
        (!('primaryCrops' in data) || (data.primaryCrops is list && data.primaryCrops.size() <= 20)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidCropScan(data, userId) {
      return data.userId == userId &&
        data.cropType is string && data.cropType.size() > 0 && data.cropType.size() <= 80 &&
        data.diseaseName is string && data.diseaseName.size() > 0 && data.diseaseName.size() <= 120 &&
        data.treatmentAdvice is string && data.treatmentAdvice.size() > 0 && data.treatmentAdvice.size() <= 10000 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 100)) &&
        (!('confidence' in data) || (data.confidence is number && data.confidence >= 0 && data.confidence <= 1)) &&
        (!('severity' in data) || (data.severity is string && data.severity.size() <= 30)) &&
        (!('symptoms' in data) || (data.symptoms is string && data.symptoms.size() <= 2000)) &&
        (!('thinkingNotes' in data) || (data.thinkingNotes is string && data.thinkingNotes.size() <= 15000)) &&
        (!('imageUri' in data) || (data.imageUri is string && data.imageUri.size() <= 500)) &&
        (!('locationName' in data) || (data.locationName is string && data.locationName.size() <= 100)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidFieldNote(data, userId) {
      return data.userId == userId &&
        data.noteContent is string && data.noteContent.size() > 0 && data.noteContent.size() <= 10000 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 100)) &&
        (!('cropName' in data) || (data.cropName is string && data.cropName.size() <= 80)) &&
        (!('plotSizeAcres' in data) || (data.plotSizeAcres is number && data.plotSizeAcres >= 0 && data.plotSizeAcres <= 10000)) &&
        (!('audioTranscript' in data) || (data.audioTranscript is string && data.audioTranscript.size() <= 10000)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /scans/{scanId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCropScan(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidFieldNote(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
