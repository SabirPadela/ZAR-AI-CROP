{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered farmer profile and farm preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "displayName": {
          "type": "string",
          "description": "Farmer name"
        },
        "email": {
          "type": "string",
          "description": "Farmer email address"
        },
        "region": {
          "type": "string",
          "description": "Agricultural division or district (e.g. Multan, Faisalabad, Hyderabad)"
        },
        "primaryCrops": {
          "type": "array",
          "description": "List of primary grown crops"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile last updated timestamp"
        }
      },
      "required": ["userId", "displayName", "email"]
    },
    "CropScan": {
      "title": "CropScan",
      "description": "Crop disease diagnostic record generated by Gemini AI",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of farmer"
        },
        "cropType": {
          "type": "string",
          "description": "Identified crop type"
        },
        "diseaseName": {
          "type": "string",
          "description": "Diagnosed disease or health status"
        },
        "confidence": {
          "type": "number",
          "description": "Diagnosis confidence score between 0 and 1"
        },
        "severity": {
          "type": "string",
          "description": "Severity assessment (Low, Moderate, High, Critical)"
        },
        "symptoms": {
          "type": "string",
          "description": "Observed crop symptoms"
        },
        "treatmentAdvice": {
          "type": "string",
          "description": "Actionable treatment and spray advice"
        },
        "thinkingNotes": {
          "type": "string",
          "description": "Deep reasoning steps from Gemini High Thinking mode"
        },
        "imageUri": {
          "type": "string",
          "description": "Reference uri or label of sample image"
        },
        "locationName": {
          "type": "string",
          "description": "City or farm location"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of diagnosis"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "cropType", "diseaseName", "treatmentAdvice"]
    },
    "FieldNote": {
      "title": "FieldNote",
      "description": "Voice or text farm field log with Gemini Transcribe",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "cropName": {
          "type": "string",
          "description": "Target crop name"
        },
        "plotSizeAcres": {
          "type": "number",
          "description": "Farm plot area in acres"
        },
        "noteContent": {
          "type": "string",
          "description": "Notes or field observations"
        },
        "audioTranscript": {
          "type": "string",
          "description": "Gemini transcribed speech text"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp"
        }
      },
      "required": ["userId", "noteContent"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Farmer profile collection"
    },
    "/users/{userId}/scans/{scanId}": {
      "schema": "CropScan",
      "description": "Crop diagnostic scan entries per farmer"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "FieldNote",
      "description": "Field logs and voice notes per farmer"
    }
  }
}
